# NextFace environment configuration example.
# Copy to .env and adjust values locally. Never commit real secrets.

# PostgreSQL
DB_NAME=nextface
DB_URL=jdbc:postgresql://localhost:5432/nextface
DB_USERNAME=nextface
DB_PASSWORD=nextface

# Backend
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# At least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=nextface-development-only-secret-key-change-me
JWT_EXPIRATION=PT1H
# Internal face-service endpoint
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_CONNECT_TIMEOUT=PT3S
FACE_SERVICE_READ_TIMEOUT=PT10S
# Face login: similarity threshold and failed attempt limiting
FACE_MATCH_THRESHOLD=0.363
FACE_LOGIN_MAX_ATTEMPTS=5
FACE_LOGIN_ATTEMPT_WINDOW=PT15M

# Face service (internal)
FACE_MIN_DETECTION_CONFIDENCE=0.5
FACE_MIN_SIZE_PX=80
FACE_BLUR_THRESHOLD=60
FACE_BRIGHTNESS_MIN=40
FACE_BRIGHTNESS_MAX=220
FACE_MAX_IMAGE_BYTES=5242880
FACE_MATCH_THRESHOLD=0.363
FACE_LIVENESS_TURN_THRESHOLD=0.08
FACE_LIVENESS_BLINK_THRESHOLD=0.19
FACE_LIVENESS_MIN_FRAMES=3
FACE_LIVENESS_MAX_FRAMES=20
